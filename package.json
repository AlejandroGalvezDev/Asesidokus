{
  "name": "murdoku",
  "version": "1.0.0",
  "description": "Murdoku: casos de misterio tipo sudoku generados de forma procedural, con solución única garantizada.",
  "main": "index.html",
  "scripts": {
    "test": "node test/verify.js && node test/smoke.js && node test/solve.js && node test/extra.js",
    "test:stress": "TRIALS=40 node test/verify.js",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [
    "murdoku",
    "sudoku",
    "logic-puzzle",
    "murder-mystery",
    "procedural-generation"
  ],
